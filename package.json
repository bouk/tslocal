  "author": "Bouke van der Bijl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouk/tslocal.git"
  },
  "homepage": "https://github.com/bouk/tslocal",
  "keywords": [
    "tailscale",
    "local-api",
    "vpn"
  ],
  "engines": {
    "node": ">=22"
  }
