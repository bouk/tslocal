{
  "name": "tslocal",
  "version": "0.1.0",
  "description": "Client library for the Tailscale Local API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.*",
    "ts/src"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4"
  },
